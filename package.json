{
  "name": "rpg",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx packages/sim-headless/src/cli.ts",
    "fight": "tsx packages/sim-headless/src/fight.ts",
    "match": "tsx packages/sim-headless/src/match.ts",
    "export-fights": "tsx packages/sim-headless/src/export-fights.ts",
    "replay": "npm run -s export-fights -- --out fights.json && node packages/sim-headless/replay/build.mjs fights.json arena-replay.html"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
