{
  "_doc": "Trait archetypes. Original content. Two weights: 'major' traits are story traits (wants, fears, grudges) with a bound target; 'minor' traits are small quirks that only matter in combination. Each trait has a short general form and a specific form. Traits only change along 'evolves' edges and keep their target. 'channels' feed the shared dials in data/channels.json ('dial' or 'dial@condition'); never write one-off perks here. Strength budget: a minor trait's channels sum to at most 0.3 in absolute value (0.15 per entry); a major trait's to at most 1.0. 'sources' says where a trait can come from.",
  "fear_of_faction": {
    "kind": "fear",
    "weight": "major",
    "sources": [
      "backstory",
      "world",
      "battle",
      "relationship"
    ],
    "general": "fears a powerful group",
    "specific": "fears {target}",
    "target": "faction",
    "channels": {
      "appraisal@target": -0.6,
      "morale@target": -0.2
    },
    "evolves": [
      {
        "to": "hatred_of_faction",
        "when": {
          "references_target": true,
          "tags_any": [
            "violence",
            "cruelty",
            "betrayal"
          ],
          "min_intensity": 0.7
        }
      },
      {
        "to": "fear_overcome",
        "when": {
          "references_target": true,
          "tags_any": [
            "victory"
          ]
        }
      }
    ]
  },
