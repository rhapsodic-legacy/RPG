{
  "_doc": "Trait archetypes. Original content. Each trait has a short general form (stable, for summaries and LLM framing) and a specific form with one bound 'target' (a faction, person, place, or detail tag). Traits only change along 'evolves' edges and keep their target, so 'fears the Halvard Syndicate' can become 'hates the Halvard Syndicate' but never something unrelated. 'channels' are generic effects other systems read; never write one-off perks here.",

  "fear_of_faction": {
    "kind": "fear", "general": "fears a powerful group", "specific": "fears {target}",
    "target": "faction",
    "channels": { "appraisal_when_referenced": -0.6, "morale_when_present": -0.2 },
    "evolves": [
      { "to": "hatred_of_faction", "when": { "references_target": true, "tags_any": ["violence", "cruelty", "betrayal"], "min_intensity": 0.7 } },
      { "to": "fear_overcome", "when": { "references_target": true, "tags_any": ["victory"] } }
    ]
  },
  "fear_of_person": {
    "kind": "fear", "general": "fears someone from their past", "specific": "fears {target}",
    "target": "person",
    "channels": { "appraisal_when_referenced": -0.6, "morale_when_present": -0.3 },
    "evolves": [
      { "to": "hatred_of_person", "when": { "references_target": true, "tags_any": ["violence", "cruelty", "betrayal"], "min_intensity": 0.7 } },
      { "to": "fear_overcome", "when": { "references_target": true, "tags_any": ["victory"] } }
    ]
  },
  "fear_of_condition": {
    "kind": "fear", "general": "has a deep-seated fear", "specific": "fears {target}",
    "target": "detail", "options": ["confined_spaces", "the_void", "losing_control", "being_left_behind"],
    "channels": { "appraisal_when_referenced": -0.5, "morale_when_present": -0.2 },
    "evolves": [
      { "to": "fear_overcome", "when": { "references_target": true, "tags_any": ["victory"], "min_intensity": 0.5 } }
    ]
  },
  "fear_overcome": {
    "kind": "past", "general": "has faced down a fear", "specific": "no longer fears {target}",
    "target": "any",
    "channels": { "morale_when_present": 0.1 },
    "evolves": []
  },

